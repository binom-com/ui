{
  "name": "@binom/ui",
  "version": "0.1.0",
  "description": "Binom design system: tokens, fonts and base rules for every Binom app (plain CSS, Tailwind 4, Material UI 5).",
  "type": "module",
  "private": false,
  "license": "MIT",
  "repository": "github:binom-com/ui",
  "exports": {
    "./theme.css": "./dist/theme.css",
    "./tokens.css": "./dist/tokens.css",
    "./fonts.css": "./dist/fonts.css",
    "./base.css": "./dist/base.css",
    "./tailwind.css": "./dist/tailwind.css",
    "./mui": {
      "types": "./dist/mui.d.ts",
      "import": "./dist/mui.js",
      "require": "./dist/mui.cjs",
      "default": "./dist/mui.js"
    },
    "./tokens.json": "./tokens/tokens.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "fonts",
    "tokens"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^5.18.0",
    "@tailwindcss/cli": "^4.3.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.3.5"
  },
  "typesVersions": {
    "*": {
      "mui": [
        "dist/mui.d.ts"
      ]
    }
  }
}
