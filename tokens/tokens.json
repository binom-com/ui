        "$value": "#3a4337"
      }
    },
    "shadow": {
      "shadow-dialog": {
        "$type": "shadow",
        "$value": "0 0 0 1px rgb(232 236 226 / 10%), 0 24px 64px rgb(0 0 0 / 60%)"
      },
      "shadow-popover": {
        "$type": "shadow",
        "$value": "0 0 0 1px rgb(232 236 226 / 8%), 0 12px 32px rgb(0 0 0 / 50%)"
      },
      "shadow-raised": {
        "$type": "shadow",
        "$value": "0 0 0 1px rgb(232 236 226 / 8%), 0 2px 8px rgb(0 0 0 / 45%)"
      },
      "shadow-snackbar": {
        "$type": "shadow",
        "$value": "0 0 0 1px rgb(232 236 226 / 12%), 0 16px 40px rgb(0 0 0 / 60%)"
      }
    }
  },
  "pointer-fine": {
    "size": {
      "small-control-size": {
        "$type": "dimension",
        "$value": "28px"
      },
      "icon-button-size": {
        "$type": "dimension",
        "$value": "36px"
      },
      "menu-item-size": {
