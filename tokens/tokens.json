{
  "$description": "Binom design tokens. Source of truth for @binom/ui: edit here, then `npm run build`. Sets: core (both themes), light, dark (same names as light), pointer-fine (mouse/trackpad overrides), reduced-motion. A token key is its CSS custom property name without `--`.",
  "core": {
    "font": {
      "font": {
        "$type": "fontFamily",
        "$value": "'DM Sans Variable', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif"
      }
    },
    "radius": {
      "radius-xs": {
        "$type": "dimension",
        "$value": "4px",
        "$description": "Corners, one scale for the whole app: xs for marks inside text (code, quotes), sm for small controls and the rows of menus and lists, the base for buttons, fields, menus and dialogs, lg for the message bar and the chat search, xl for cards, toasts and bubbles, pill for chips and badges."
      },
      "radius-sm": {
        "$type": "dimension",
        "$value": "6px"
      },
      "radius": {
        "$type": "dimension",
        "$value": "9px"
      },
      "radius-lg": {
        "$type": "dimension",
        "$value": "14px"
      },
      "radius-xl": {
        "$type": "dimension",
        "$value": "16px"
      },
      "radius-pill": {
        "$type": "dimension",
        "$value": "999px"
      }
    },
    "size": {
      "tap-size": {
        "$type": "dimension",
        "$value": "44px"
      },
      "icon-button-size": {
        "$type": "dimension",
        "$value": "40px",
        "$description": "Round icon buttons (header 🔍 / ⋮, ×, the composer's icons): a little under a finger's size, so a row of them stands close together; with a mouse a step smaller still."
      },
      "small-control-size": {
        "$type": "dimension",
        "$value": "36px",
        "$description": "Compact controls in column headers and dialogs (Invite, New chat, Copy link)."
      },
      "icon-button-size-sm": {
        "$type": "dimension",
        "$value": "28px",
        "$description": "A round icon button inside another control (a field's ×, a code block's Copy, the credits' +)."
      },
      "menu-item-size": {
        "$type": "dimension",
        "$value": "{size.tap-size}",
        "$description": "A row of every menu (⋮, a message's, a task's, Send's, the user menu): finger-sized on touch."
      },
      "sheet-item-size": {
        "$type": "dimension",
        "$value": "52px",
        "$description": "A row of a menu risen from the bottom as a sheet on a phone (⋮, the user menu, a select's options): one size everywhere, a step over a finger's, so it is easy to hit."
      }
    },
    "motion": {
      "motion-fast": {
        "$type": "duration",
        "$value": "140ms",
        "$description": "Motion: every transition and animation takes one of these durations and curves, so the whole app moves alike. Fast for a hover, a press, a tooltip and anything leaving; base for a menu, a message, a control's state; slow for a dialog and a screen. Things come in decelerating (`--ease-out`), leave accelerating (`--ease-in`), change in place on `--ease-standard`; a small thing that pops (a knob, an emoji, ↓) overshoots on `--ease-spring`. «Less motion» in the system settings turns them all off (see «Motion» at the end)."
      },
      "motion-base": {
        "$type": "duration",
        "$value": "220ms"
      },
      "motion-slow": {
        "$type": "duration",
        "$value": "320ms"
      },
      "ease-out": {
        "$type": "cubicBezier",
        "$value": "cubic-bezier(0.22, 1, 0.36, 1)"
      },
      "ease-in": {
        "$type": "cubicBezier",
        "$value": "cubic-bezier(0.55, 0, 1, 0.45)"
      },
      "ease-standard": {
        "$type": "cubicBezier",
        "$value": "cubic-bezier(0.2, 0, 0, 1)"
      },
      "ease-spring": {
        "$type": "cubicBezier",
        "$value": "cubic-bezier(0.34, 1.56, 0.64, 1)"
      }
    }
  },
  "light": {
    "color": {
      "color-page": {
        "$type": "color",
        "$value": "#f7f8f2",
        "$description": "The page behind every column; fields, cards, popovers and dialogs stay white (--color-bg) on it."
      },
      "color-bg": {
        "$type": "color",
        "$value": "#ffffff"
      },
      "color-text": {
        "$type": "color",
        "$value": "#202720"
      },
      "color-danger": {
        "$type": "color",
        "$value": "#b3261e"
      },
      "color-muted": {
        "$type": "color",
        "$value": "#656b61"
      },
      "color-border": {
        "$type": "color",
        "$value": "#e3e4e0"
      },
      "color-surface": {
        "$type": "color",
        "$value": "#f0f0ed",
        "$description": "Hover and quiet fills: a step darker than the page, so they show on it."
      },
      "color-button": {
        "$type": "color",
        "$value": "#ebebe8",
        "$description": "Plain filled buttons (Cancel, Remove, Add seats, Copy link): a fill that shows on white, darker on hover."
      },
      "color-button-hover": {
        "$type": "color",
        "$value": "#dfe0dc"
      },
      "color-accent": {
        "$type": "color",
        "$value": "#384c2c"
      },
      "color-accent-hover": {
        "$type": "color",
        "$value": "#2a3a20"
      },
      "color-tint": {
        "$type": "color",
        "$value": "rgb(90 154 30)",
        "$description": "Tints: link-like chips, quotes, hovered rows, selected messages. A fresh green, not the dark accent, which goes swampy grey when see-through."
      },
      "color-accent-soft": {
        "$type": "color",
        "$value": "rgb(90 154 30 / 9%)"
      },
      "color-accent-soft-hover": {
        "$type": "color",
        "$value": "rgb(90 154 30 / 15%)"
      },
      "color-highlight": {
        "$type": "color",
        "$value": "#def5b0"
      },
      "color-highlight-hover": {
        "$type": "color",
        "$value": "#cfeb98"
      },
      "color-focus-ring": {
        "$type": "color",
        "$value": "rgb(130 164 81 / 40%)"
      },
      "color-on-accent": {
        "$type": "color",
        "$value": "#ffffff"
      },
      "color-backdrop": {
        "$type": "color",
        "$value": "rgb(20 22 20 / 38%)",
        "$description": "What lifts a dialog and a menu off the page: the dimmed page behind a dialog and their shadows."
      },
      "color-snackbar": {
        "$type": "color",
        "$value": "#3d4a36",
        "$description": "Toasts and snackbars: dark in both themes; here a deep muted green (not the ink), so they read without shouting, with the lime for their actions and a soft shadow."
      },
      "color-snackbar-text": {
        "$type": "color",
        "$value": "#f7f8f2"
      },
      "color-snackbar-muted": {
        "$type": "color",
        "$value": "rgb(247 248 242 / 70%)"
      },
      "color-snackbar-action": {
        "$type": "color",
        "$value": "#def5b0"
      },
      "color-snackbar-hover": {
        "$type": "color",
        "$value": "rgb(255 255 255 / 12%)"
      },
      "color-link": {
        "$type": "color",
        "$value": "#4f7a2b",
        "$description": "Mentions and links in messages: a green bright enough to stand apart from the dark text."
      },
      "color-ai": {
        "$type": "color",
        "$value": "#6a4bab",
        "$description": "The AI's own colour: a muted violet, the complement of the green, so its answers stand out."
      },
      "color-segment-on": {
        "$type": "color",
        "$value": "#ffffff",
        "$description": "The pressed segment of a segmented switch (System | Light | Dark, All | Groups | Personal)."
      }
    },
    "shadow": {
      "shadow-dialog": {
        "$type": "shadow",
        "$value": "0 16px 48px rgb(32 39 32 / 18%)"
      },
      "shadow-popover": {
        "$type": "shadow",
        "$value": "0 8px 24px rgb(32 39 32 / 12%)"
      },
      "shadow-raised": {
        "$type": "shadow",
        "$value": "0 1px 4px rgb(32 39 32 / 15%)",
        "$description": "Small things floating over the page without a panel's weight: a tooltip, the ⌄ button, the typing pill."
      },
      "shadow-snackbar": {
        "$type": "shadow",
        "$value": "0 8px 24px rgb(32 39 32 / 16%), 0 1px 3px rgb(32 39 32 / 10%)"
      }
    }
  },
  "dark": {
    "color": {
      "color-page": {
        "$type": "color",
        "$value": "#141814"
      },
      "color-bg": {
        "$type": "color",
        "$value": "#1d221c"
      },
      "color-text": {
        "$type": "color",
        "$value": "#e8ece2"
      },
      "color-danger": {
        "$type": "color",
        "$value": "#f2b8b5"
      },
      "color-muted": {
        "$type": "color",
        "$value": "#9aa294"
      },
      "color-border": {
        "$type": "color",
        "$value": "#2e352c"
      },
      "color-surface": {
        "$type": "color",
        "$value": "#252b24"
      },
      "color-button": {
        "$type": "color",
        "$value": "#2a3128"
      },
      "color-button-hover": {
        "$type": "color",
        "$value": "#353d32"
      },
      "color-accent": {
        "$type": "color",
        "$value": "#bfdf86"
      },
      "color-accent-hover": {
        "$type": "color",
        "$value": "#cfeb98"
      },
      "color-accent-soft": {
