        "$value": "{color.color-accent}"
      },
      "color-accent-soft-hover": {
        "$type": "color",
        "$value": "rgb(191 223 134 / 16%)"
      },
      "color-highlight": {
        "$type": "color",
        "$value": "#3b4b25"
      },
      "color-highlight-hover": {
        "$type": "color",
        "$value": "#46592c"
      },
      "color-focus-ring": {
        "$type": "color",
        "$value": "rgb(191 223 134 / 35%)"
      },
      "color-on-accent": {
        "$type": "color",
        "$value": "#141814"
      },
      "color-backdrop": {
        "$type": "color",
        "$value": "rgb(0 0 0 / 62%)",
        "$description": "On near-black paper a shadow barely shows: the page dims far more, and a hairline of light (a shadow, not a border) traces the edge of a dialog or a menu."
      },
      "color-snackbar": {
        "$type": "color",
        "$value": "#2f382c",
        "$description": "Toasts and snackbars stay dark here too: a raised green-grey surface, lifted by a light hairline and a deep shadow."
      },
      "color-snackbar-text": {
        "$type": "color",
        "$value": "#eef2e8"
      },
      "color-snackbar-muted": {
        "$type": "color",
        "$value": "rgb(238 242 232 / 65%)"
      },
      "color-snackbar-action": {
        "$type": "color",
        "$value": "#cfeb98"
      },
      "color-snackbar-hover": {
