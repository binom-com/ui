        "$value": "rgb(255 255 255 / 10%)"
      },
      "color-link": {
        "$type": "color",
        "$value": "#9ccc65"
      },
      "color-ai": {
        "$type": "color",
        "$value": "#a98ce0"
      },
      "color-segment-on": {
